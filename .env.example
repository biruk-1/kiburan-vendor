# Same Supabase project as the Kiburan client app — never a separate project.
# Local: start the shared stack from ../kiburan (npm run db:start), then copy the URL and
# anon/publishable key from `npm run db:status` there.
# For Expo Go on a phone, 127.0.0.1 is auto-rewritten to the Metro LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key

# Never put the service-role key in this app or in any EXPO_PUBLIC_ variable.
